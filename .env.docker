# Caminho do arquivo CSV dentro do container
CAMINHO_ARQUIVO=/opt/airflow/data/202602_Despesas.csv

# Conexão com o banco
PG_USER=airflow
PG_PASSWORD=airflow
PG_HOST=airflow_postgres
PG_PORT=5432
PG_DBNAME=projeto_gastos_governamentais


# Tabelas do banco
TABLE_FATO=fato_gastos
TABLE_DIM_ORGAO=dim_orgao
TABLE_DIM_UNIDADE_GESTORA=dim_unidade_gestora
TABLE_DIM_FUNCAO=dim_funcao
TABLE_DIM_PROGRAMA=dim_programa
TABLE_DIM_ACAO=dim_acao
TABLE_DIM_DESPESAS=dim_despesas
TABLE_DIM_LOCALIZACAO=dim_localizacao